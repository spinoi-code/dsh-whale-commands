{
  "name": "dsh-whale-commands",
  "version": "1.3.0",
  "description": "Slash commands for the DeepSeek Harness Weixin channel: persona toggle & multi-persona library, session history (soft load or real session switch), model selection, token usage and balance, scheduled daily greetings. Host-side execution, zero model tokens, hot-reload. Also ships compatibility notes and patches that let 0.1-era channel plugins run on harness 0.2.",
  "type": "module",
  "license": "AGPL-3.0",
  "author": "spinoi-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinoi-code/dsh-whale-commands.git"
  },
  "bugs": {
    "url": "https://github.com/spinoi-code/dsh-whale-commands/issues"
  },
  "homepage": "https://github.com/spinoi-code/dsh-whale-commands#readme",
  "keywords": [
    "dsh-plugins",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "weixin",
    "wechat",
    "slash-commands",
    "persona",
    "whale",
    "multi-persona",
    "harness-0.2",
    "compat",
    "migration",
    "search",
    "web-search",
    "deep-research",
    "ai-summary"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "scripts",
    "greetings",
    "docs",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "LICENSE",
    "compat",
    "patches",
    "cordis.patch.yml"
  ],
  "scripts": {
    "install-plugin": "./install.sh",
    "uninstall-plugin": "./uninstall.sh",
    "scan": "./scripts/scan-secrets.sh"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
